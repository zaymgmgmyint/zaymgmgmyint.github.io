---
import Base from "../layouts/Base.astro";
import { nav } from "../data/site.js";

// GitHub Pages serves dist/404.html for any unknown URL.
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="container page fade-in">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="muted lead">
      That page doesn't exist, or it has moved. Try one of these instead.
    </p>
    <ul class="links">
      <li><a href="/">Home</a></li>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .page {
    padding-top: var(--space-6);
  }
  .lead {
    max-width: var(--measure);
    font-size: 1.125rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
</style>
