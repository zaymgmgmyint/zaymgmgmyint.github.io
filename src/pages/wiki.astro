---
import { getCollection, render } from "astro:content";
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import CopyButton from "../components/CopyButton.jsx";

const entries = await getCollection("wiki");
const byTitle = (a, b) => a.data.title.localeCompare(b.data.title);
const snippets = entries.filter((e) => e.data.type === "snippet").sort(byTitle);
const terms = await Promise.all(
  entries
    .filter((e) => e.data.type === "term")
    .sort(byTitle)
    .map(async (e) => ({ entry: e, Content: (await render(e)).Content })),
);
const snippetBodies = await Promise.all(
  snippets.map(async (e) => ({ entry: e, Content: (await render(e)).Content })),
);
const tags = [...new Set(snippets.flatMap((e) => e.data.tags))].sort();
---

<Base
  title="Wiki"
  description="Code snippets and plain-language definitions from Zay Maung Maung Myint."
>
  <section class="container page fade-in">
    <p class="eyebrow">Wiki</p>
    <h1>Wiki</h1>
    <p class="muted lead">
      Snippets I reach for often, and plain-language definitions of terms that come up in
      architecture conversations.
    </p>
    <p class="jump"><a href="#snippets">Snippets</a> · <a href="#glossary">Glossary</a></p>
  </section>

  <section class="container section" id="snippets">
    <h2>Snippets</h2>
    <div class="filters">
      <label class="sr-only" for="q">Search snippets</label>
      <input id="q" type="search" placeholder="Search snippets" autocomplete="off" />
      <div class="chips" role="group" aria-label="Filter by tag">
        {tags.map((t) => <button type="button" class="chip" aria-pressed="false" data-tag={t}>{t}</button>)}
      </div>
    </div>

    <div id="snippet-list">
      {
        snippetBodies.map(({ entry, Content }) => (
          <article
            id={entry.id}
            class="snippet"
            data-tags={entry.data.tags.join("|")}
            data-text={`${entry.data.title} ${entry.data.tags.join(" ")}`.toLowerCase()}
          >
            <header class="snippet__head">
              <h3>{entry.data.title}</h3>
              <CopyButton client:visible text={entry.data.code} />
            </header>
            <Code
              code={entry.data.code}
              lang={entry.data.language}
              themes={{ light: "github-light", dark: "github-dark" }}
              defaultColor={false}
              wrap
            />
            <div class="snippet__note muted">
              <Content />
            </div>
            <p class="snippet__tags">
              {entry.data.tags.map((t) => <span class="chip">{t}</span>)}
            </p>
          </article>
        ))
      }
    </div>
    <p id="no-results" class="muted" hidden>No snippets match. Try another word or tag.</p>
  </section>

  <section class="container section" id="glossary">
    <h2>Glossary</h2>
    <dl class="terms">
      {
        terms.map(({ entry, Content }) => (
          <div class="term" id={entry.id}>
            <dt>{entry.data.title}</dt>
            <dd class="muted"><Content /></dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("#q");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("button.chip[data-tag]")];
  const items = [...document.querySelectorAll<HTMLElement>(".snippet")];
  const empty = document.querySelector<HTMLElement>("#no-results");
  let activeTag = "";

  function apply() {
    const q = (input?.value ?? "").trim().toLowerCase();
    let shown = 0;
    for (const el of items) {
      const tagOk = !activeTag || (el.dataset.tags ?? "").split("|").includes(activeTag);
      const textOk = !q || (el.dataset.text ?? "").includes(q);
      el.hidden = !(tagOk && textOk);
      if (!el.hidden) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  }

  input?.addEventListener("input", apply);
  for (const chip of chips) {
    chip.addEventListener("click", () => {
      activeTag = activeTag === chip.dataset.tag ? "" : (chip.dataset.tag ?? "");
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.tag === activeTag)));
      apply();
    });
  }
</script>

<style>
  .page {
    padding-top: var(--space-5);
  }
  .lead {
    max-width: var(--measure);
    font-size: 1.125rem;
  }
  .jump {
    font-size: 0.9375rem;
  }
  .section {
    padding-top: var(--space-5);
  }
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-3) 0;
  }
  input[type="search"] {
    width: 100%;
    max-width: 24rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
  }
  .chips,
  .snippet__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .snippet {
    padding-block: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .snippet[hidden] {
    display: none;
  }
  .snippet__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .snippet__head h3 {
    margin: 0;
  }
  .snippet__note {
    margin-block: var(--space-1);
    font-size: 0.9375rem;
  }
  .snippet__note :global(p) {
    margin: 0;
  }
  .terms {
    margin: var(--space-3) 0 0;
  }
  .term {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .term dt {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }
  .term dd {
    margin: 0;
  }
  .term dd :global(p) {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .term {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
