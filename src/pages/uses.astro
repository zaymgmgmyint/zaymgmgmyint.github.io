---
import Base from "../layouts/Base.astro";
import { uses } from "../data/uses.js";

const groups = uses.filter((g) => g.items.length > 0);
---

<Base title="Uses" description="The tools and stack Zay Maung Maung Myint uses day to day.">
  <section class="container page fade-in">
    <p class="eyebrow">Uses</p>
    <h1>Uses</h1>
    <p class="muted lead">The tools and stack I rely on day to day.</p>

    {
      groups.map((g) => (
        <div class="group">
          <h2>{g.group}</h2>
          <ul>
            {g.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .page {
    padding-top: var(--space-5);
  }
  .lead {
    max-width: var(--measure);
    font-size: 1.125rem;
  }
  .group {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .group h2 {
    font-size: 1.125rem;
    margin: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding-block: 0.25rem;
  }
  @media (max-width: 40rem) {
    .group {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
